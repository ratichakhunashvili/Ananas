# Used only by `npm run create-admin` (scripts/createAdmin.mjs), which runs
# locally with the Firebase Admin SDK - never bundled into the web app.
# Copy this file to .env.admin and fill in real values. Never commit .env.admin.

ADMIN_EMAIL=you@yourschool.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_DISPLAY_NAME=Head Admin

# Realtime Database URL, e.g. https://<project-id>-default-rtdb.<region>.firebasedatabase.app
FIREBASE_DATABASE_URL=

# Path to a Firebase service account JSON key (Firebase Console -> Project
# settings -> Service accounts -> Generate new private key). Keep this file
# outside of git (it's covered by .gitignore if placed at the project root).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
