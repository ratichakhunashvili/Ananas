# Firebase project config (Project settings -> General -> Your apps -> SDK setup and configuration)
# Copy this file to .env.local and fill in real values. Never commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database URL, e.g. https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=

# Domain used to build synthetic emails for username/password logins (participants + spectators).
# Does not need to be a real, reachable domain.
VITE_AUTH_USERNAME_DOMAIN=ananas.local

# Optional: YouTube Data API v3 key, used by the Admin music library search.
# Without it, Admin can still add tracks by pasting a YouTube URL/ID directly.
VITE_YOUTUBE_API_KEY=
